# Enables the MSW mock layer (REST + Socket.IO). Keep "true" for dev, demo build and E2E tests.
VITE_ENABLE_MOCKS=true

# Base URL used by Axios. With mocks enabled, MSW intercepts requests to this origin.
VITE_API_BASE_URL=/api

# Socket.IO server URL. With mocks enabled, @mswjs/socket.io-binding intercepts this connection.
VITE_SOCKET_URL=wss://realtime.kurio.local

# Default mock scenario (see docs/MOCKS.md). Can be overridden per tab with ?scenario=<name>.
VITE_MOCK_SCENARIO=default
